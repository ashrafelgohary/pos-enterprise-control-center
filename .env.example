# ============================================================================
#  POS Control Center - environment configuration
#  cp .env.example .env && chmod 600 .env   (never commit .env)
# ============================================================================

# --- Core -------------------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO
# Generate: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE_AT_LEAST_32_CHARS
# Host headers accepted by the API (JSON list). Restrict in production.
ALLOWED_HOSTS=["*"]
ACCESS_TOKEN_TTL_MINUTES=60
# true = cookies only over HTTPS (terminate TLS on your NGINX host). false only for plain-HTTP labs.
COOKIE_SECURE=true
LOGIN_RATE_LIMIT_PER_MINUTE=10
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# --- Database / Redis (docker-compose builds the URLs) ----------------------
POSTGRES_USER=poscc
POSTGRES_DB=poscc
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# --- First start: initial admin (remove the password after first login) ------
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@alshaya.eg.local
INITIAL_ADMIN_PASSWORD=CHANGE_ME_Adm1n!Pass

# --- Uploads ----------------------------------------------------------------
MAX_XML_SIZE_MB=5
MAX_FILES_PER_UPLOAD=200
# Element/attribute names searched inside XML to identify the POS when the filename doesn't match
XML_HOSTNAME_TAGS=["Hostname","HostName","PosName","PosId","TerminalId","DeviceName"]

# --- Ansible integration (worker only) --------------------------------------
ANSIBLE_PLAYBOOK=site.yml
ANSIBLE_INVENTORY_GROUP=pos
ANSIBLE_FORKS=20
ANSIBLE_TIMEOUT_SECONDS=1800
ANSIBLE_HOST_KEY_CHECKING=false
ANSIBLE_VERBOSITY=0
# password = same as your `-k -K` runs ; key = secrets/ansible_ssh_key
ANSIBLE_AUTH_MODE=password
ANSIBLE_USER=ashraf
# Map platform vars to the names your playbook already uses (JSON), e.g. {"xml_src_path":"pos_xml_src"}
ANSIBLE_VAR_MAP={}
# Extra static vars for every run (JSON)
ANSIBLE_EXTRA_VARS={}
# Optional staging hook replicating scripts/stage_pos_xmls.py, e.g. /ansible-staging/{hostname}/{filename}
ANSIBLE_STAGE_PATH_TEMPLATE=
KEEP_RUN_ARTIFACTS_DAYS=30
WORKER_CONCURRENCY=4

# --- POS health checks (TCP connect to SSH port) ----------------------------
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL_SECONDS=120
HEALTH_CHECK_PORT=22
HEALTH_CHECK_TIMEOUT_SECONDS=2

# --- Images / publishing ----------------------------------------------------
# REGISTRY=harbor.alshaya.eg.local/infra
TAG=1.0.0
HTTP_BIND=0.0.0.0
HTTP_PORT=8080
